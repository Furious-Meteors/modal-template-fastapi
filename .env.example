# Local settings for testing against Supabase.
#
#   cp .env.example .env        # .env is git-ignored AND excluded from the Modal image
#   (edit .env, then)  python scripts/check_supabase.py
#
# Never commit real values. Do not name this file .env.local / .env.test: only the
# exact name ".env" is in .gitignore.
#
# Where to find the strings: Supabase dashboard → Connect (or Project Settings →
# Database → Connection string). Replace the WHOLE [YOUR-PASSWORD] placeholder,
# square brackets included, with your password — URL-encoded if it contains any of
# @ : / ? #   (for example @ becomes %40).

# ── The app (scripts/run_local.py) ──────────────────────────────────────────
PERSISTENCE_BACKEND=postgres
EVENT_BUS_BACKEND=postgres

# Normal queries: the TRANSACTION pooler (port 6543). Note the user: postgres.<project-ref>
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres

# Instant event delivery needs a SESSION connection: same pooler host, port 5432
# (or the direct db.<project-ref>.supabase.co:5432 URL). Leave empty to poll instead.
EVENT_BUS_LISTEN_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-at-least-32-random-characters
WEBHOOK_SECRET_ACME=change-me-webhook-secret-value
MODAL_ENV=dev

# Keep the pool small locally: the free tier has few pooler connections.
DB_POOL_MAX_SIZE=3

# ── The test suite (pytest) ─────────────────────────────────────────────────
# The Postgres tests DROP AND RECREATE the items, events, webhook_events and
# ws_ticket_uses tables. Use a dedicated, empty Supabase project for this — never
# one holding real data. Leave unset to skip the Postgres tests.
#
# TEST_DATABASE_URL=postgresql://postgres.<test-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# TEST_LISTEN_DATABASE_URL=postgresql://postgres.<test-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Required whenever TEST_DATABASE_URL is not localhost: confirms you accept the DROPs.
# ALLOW_DESTRUCTIVE_DB_TESTS=yes
